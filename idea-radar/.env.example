# --- core ---
DATABASE_URL=sqlite:///./idearadar.db
ADMIN_API_KEY=change-me-long-random          # required, every route is authenticated
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
DAILY_LLM_BUDGET_USD=8                        # hard cap, pipeline stops when reached

# --- safety (defaults are the safe ones) ---
DRY_RUN=true                                  # nothing is sent while true
LIVE_CHANNELS=                                # comma list, e.g. x,reddit ; empty = nothing live
KILL_SWITCH=false

# --- sources ---
YOUTUBE_API_KEY=

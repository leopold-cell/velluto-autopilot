{% comment %}
  ─────────────────────────────────────────────────────────────────────────────
  VELLUTO — EU Withdrawal Form (Widerrufsbutton)
  ─────────────────────────────────────────────────────────────────────────────
  Implements the EU withdrawal function required from 19 June 2026
  (Directive (EU) 2023/2673): a two-step withdrawal flow —
    Step 1: name, email, order number (+ optional note)
    Step 2: read-only summary + explicit "Withdraw from contract now" button
  followed by an automatic confirmation email.

  Mechanics:
  - Submission uses Shopify's native contact form ({% raw %}{% form 'contact' %}{% endraw %}),
    so every withdrawal lands in the store's contact inbox (merchant-side
    record), prefixed "[Withdrawal]".
  - On final submit a client-side Klaviyo event (metric: "Withdrawal
    Requested") is fired with the submitted data; a Klaviyo flow on that
    metric sends the automatic confirmation email (content + timestamp).
    Configure the Klaviyo PUBLIC site key in the section settings.
  - Progressive: without JavaScript the form renders as a single step with a
    mandatory confirmation checkbox, so the explicit-confirmation requirement
    still holds and submission still works (the confirmation email is then
    sent manually from the inbox).

  Wording note: button labels follow the directive's "withdraw from contract
  here / now" pattern — adjust via section settings only after legal review.
{% endcomment %}

<div class="vwd" id="vwd-{{ section.id }}">
  <div class="vwd__inner">
    <h1 class="vwd__heading">{{ section.settings.heading }}</h1>
    <p class="vwd__intro">{{ section.settings.intro }}</p>

    {% form 'contact', id: 'vwd-form', class: 'vwd__form' %}
      {%- if form.posted_successfully? -%}
        <div class="vwd__success" role="status" tabindex="-1">
          <strong>{{ section.settings.success_heading }}</strong>
          <p>{{ section.settings.success_text }}</p>
        </div>
      {%- else -%}

        {%- if form.errors -%}
          <div class="vwd__errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        {%- comment -%} Step 1: details {%- endcomment -%}
        <div class="vwd__step" data-vwd-step="1">
          <label class="vwd__label" for="vwd-name">{{ section.settings.label_name }} *</label>
          <input class="vwd__input" type="text" id="vwd-name" name="contact[Name]" required autocomplete="name">

          <label class="vwd__label" for="vwd-email">{{ section.settings.label_email }} *</label>
          <input class="vwd__input" type="email" id="vwd-email" name="contact[email]" required autocomplete="email">

          <label class="vwd__label" for="vwd-order">{{ section.settings.label_order }} *</label>
          <input class="vwd__input" type="text" id="vwd-order" name="contact[Order number]" required placeholder="#1234" autocomplete="off">

          <label class="vwd__label" for="vwd-note">{{ section.settings.label_note }}</label>
          <textarea class="vwd__input vwd__input--area" id="vwd-note" name="contact[Note]" rows="3"></textarea>

          {%- comment -%}
            Marks the inbox email and records the submission timestamp
            (filled by JS; the directive requires the confirmation to state
            the time the withdrawal was exercised).
          {%- endcomment -%}
          <input type="hidden" name="contact[Subject]" value="[Withdrawal] Right of withdrawal exercised">
          <input type="hidden" name="contact[Submitted at]" value="" data-vwd-timestamp>
          {%- comment -%} Shopify's contact form expects a body field. {%- endcomment -%}
          <input type="hidden" name="contact[body]" value="[Withdrawal] A customer has exercised their right of withdrawal via the withdrawal form. Details are listed in the fields above.">

          {%- comment -%}
            No-JS fallback: single-step with explicit confirmation checkbox
            + direct submit. JS replaces this with the two-step flow.
          {%- endcomment -%}
          <div data-vwd-nojs>
            <label class="vwd__confirm-check">
              <input type="checkbox" required>
              {{ section.settings.confirm_checkbox_label }}
            </label>
            <button type="submit" class="vwd__btn vwd__btn--primary">
              {{ section.settings.confirm_button_label }}
            </button>
          </div>

          <button type="button" class="vwd__btn vwd__btn--primary" data-vwd-continue hidden>
            {{ section.settings.continue_label }}
          </button>
        </div>

        {%- comment -%} Step 2: summary + explicit confirmation {%- endcomment -%}
        <div class="vwd__step" data-vwd-step="2" hidden>
          <h2 class="vwd__subheading">{{ section.settings.review_heading }}</h2>
          <dl class="vwd__summary" data-vwd-summary></dl>
          <p class="vwd__legal">{{ section.settings.review_text }}</p>
          <button type="submit" class="vwd__btn vwd__btn--primary" data-vwd-submit>
            {{ section.settings.confirm_button_label }}
          </button>
          <button type="button" class="vwd__btn vwd__btn--ghost" data-vwd-back>
            {{ section.settings.back_label }}
          </button>
        </div>

      {%- endif -%}
    {% endform %}
  </div>
</div>

{% style %}
  #vwd-{{ section.id }} { padding: 56px 20px 80px; background: #fff; color: #1c1b18; }
  #vwd-{{ section.id }} .vwd__inner { max-width: 560px; margin: 0 auto; }
  #vwd-{{ section.id }} .vwd__heading { font-size: clamp(26px, 4vw, 34px); font-weight: 600; margin: 0 0 10px; }
  #vwd-{{ section.id }} .vwd__intro { font-size: 15px; line-height: 1.6; color: #6f6a60; margin: 0 0 28px; }
  #vwd-{{ section.id }} .vwd__subheading { font-size: 19px; font-weight: 600; margin: 0 0 16px; }
  #vwd-{{ section.id }} .vwd__label { display: block; font-size: 12px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; margin: 18px 0 6px; color: #555; }
  #vwd-{{ section.id }} .vwd__input {
    width: 100%; padding: 13px 14px; border: 1.5px solid #e3e3e3; border-radius: 10px;
    font-size: 15px; font-family: inherit; background: #fff; color: inherit;
  }
  #vwd-{{ section.id }} .vwd__input:focus { outline: none; border-color: #1c1b18; }
  #vwd-{{ section.id }} .vwd__btn {
    display: block; width: 100%; margin-top: 22px; padding: 15px 24px; border-radius: 10px;
    font-size: 15px; font-weight: 700; letter-spacing: .02em; cursor: pointer; text-align: center;
    border: 1.5px solid #1c1b18; transition: background .2s ease, color .2s ease;
  }
  #vwd-{{ section.id }} .vwd__btn--primary { background: #1c1b18; color: #fff; }
  #vwd-{{ section.id }} .vwd__btn--primary:hover { background: #3a3a3a; }
  #vwd-{{ section.id }} .vwd__btn--ghost { background: transparent; color: #1c1b18; margin-top: 10px; }
  #vwd-{{ section.id }} .vwd__summary { border: 1px solid #eee; border-radius: 12px; padding: 16px 18px; margin: 0 0 14px; }
  #vwd-{{ section.id }} .vwd__summary dt { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: #888; margin-top: 10px; }
  #vwd-{{ section.id }} .vwd__summary dt:first-child { margin-top: 0; }
  #vwd-{{ section.id }} .vwd__summary dd { margin: 2px 0 0; font-size: 15px; }
  #vwd-{{ section.id }} .vwd__legal { font-size: 13px; color: #6f6a60; line-height: 1.55; }
  #vwd-{{ section.id }} .vwd__confirm-check { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; margin-top: 22px; }
  #vwd-{{ section.id }} .vwd__success { border: 1.5px solid #2f6b3a; background: #f1f8f2; color: #2f6b3a; border-radius: 12px; padding: 18px 20px; }
  #vwd-{{ section.id }} .vwd__success p { margin: 6px 0 0; }
  #vwd-{{ section.id }} .vwd__errors { border: 1.5px solid #9d2235; background: #fbf1f3; color: #9d2235; border-radius: 12px; padding: 14px 18px; margin-bottom: 18px; }
{% endstyle %}

<script>
  (function () {
    var root = document.getElementById('vwd-{{ section.id }}');
    if (!root || root.dataset.vwdInit) return;
    root.dataset.vwdInit = 'true';

    var form = root.querySelector('.vwd__form');
    if (!form) return;
    var step1 = root.querySelector('[data-vwd-step="1"]');
    var step2 = root.querySelector('[data-vwd-step="2"]');
    if (!step1 || !step2) return;

    /* JS available → switch from the single-step fallback to the two-step
       flow required UX (details → explicit confirmation). */
    var nojs = root.querySelector('[data-vwd-nojs]');
    var cont = root.querySelector('[data-vwd-continue]');
    if (nojs) nojs.hidden = true;
    var nojsCheck = nojs ? nojs.querySelector('input[type="checkbox"]') : null;
    if (nojsCheck) nojsCheck.required = false;
    if (cont) cont.hidden = false;

    function field(name) { return form.querySelector('[name="contact[' + name + ']"]'); }

    if (cont) cont.addEventListener('click', function () {
      var required = [field('Name'), field('email'), field('Order number')];
      for (var i = 0; i < required.length; i++) {
        if (!required[i].reportValidity()) return;
      }
      var summary = root.querySelector('[data-vwd-summary]');
      summary.innerHTML = '';
      [['{{ section.settings.label_name | escape }}', field('Name').value],
       ['{{ section.settings.label_email | escape }}', field('email').value],
       ['{{ section.settings.label_order | escape }}', field('Order number').value],
       ['{{ section.settings.label_note | escape }}', field('Note').value]].forEach(function (row) {
        if (!row[1]) return;
        var dt = document.createElement('dt'); dt.textContent = row[0];
        var dd = document.createElement('dd'); dd.textContent = row[1];
        summary.appendChild(dt); summary.appendChild(dd);
      });
      step1.hidden = true; step2.hidden = false;
      step2.querySelector('[data-vwd-submit]').focus();
    });

    var back = root.querySelector('[data-vwd-back]');
    if (back) back.addEventListener('click', function () {
      step2.hidden = true; step1.hidden = false;
    });

    form.addEventListener('submit', function () {
      var now = new Date().toISOString();
      var ts = form.querySelector('[data-vwd-timestamp]');
      if (ts) ts.value = now;

      /* Fire the Klaviyo event that triggers the automatic confirmation
         email (keepalive so it survives the form navigation). Failure here
         never blocks the legal submission itself. */
      var companyId = {{ section.settings.klaviyo_public_key | json }};
      if (companyId) {
        try {
          fetch('https://a.klaviyo.com/client/events/?company_id=' + encodeURIComponent(companyId), {
            method: 'POST',
            keepalive: true,
            headers: { 'Content-Type': 'application/json', 'revision': '2024-10-15' },
            body: JSON.stringify({
              data: {
                type: 'event',
                attributes: {
                  metric: { data: { type: 'metric', attributes: { name: {{ section.settings.klaviyo_metric_name | json }} } } },
                  profile: { data: { type: 'profile', attributes: {
                    email: field('email').value,
                    first_name: field('Name').value
                  } } },
                  properties: {
                    Name: field('Name').value,
                    OrderNumber: field('Order number').value,
                    Note: field('Note') ? field('Note').value : '',
                    SubmittedAt: now
                  }
                }
              }
            })
          });
        } catch (e) { /* non-blocking */ }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Withdrawal Form (EU)",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Right of withdrawal" },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "You can withdraw from your contract within 14 days of receiving your order, without giving any reason. Fill in the details below and confirm — we will send you a confirmation by email right away."
    },
    { "type": "header", "content": "Field labels" },
    { "type": "text", "id": "label_name", "label": "Name label", "default": "Full name" },
    { "type": "text", "id": "label_email", "label": "Email label", "default": "Email address" },
    { "type": "text", "id": "label_order", "label": "Order label", "default": "Order number" },
    { "type": "text", "id": "label_note", "label": "Note label", "default": "Note (optional)" },
    { "type": "header", "content": "Step 2 — confirmation" },
    { "type": "text", "id": "continue_label", "label": "Continue button", "default": "Continue" },
    { "type": "text", "id": "review_heading", "label": "Review heading", "default": "Review your withdrawal" },
    {
      "type": "textarea",
      "id": "review_text",
      "label": "Review text",
      "default": "By clicking the button below you exercise your statutory right of withdrawal for the order stated above. You will receive an automatic confirmation by email including the date and time of your withdrawal."
    },
    { "type": "text", "id": "confirm_button_label", "label": "Confirm button", "default": "Withdraw from contract now" },
    { "type": "text", "id": "back_label", "label": "Back button", "default": "Back" },
    {
      "type": "text",
      "id": "confirm_checkbox_label",
      "label": "No-JS confirmation checkbox",
      "default": "I hereby withdraw from my contract for the order stated above."
    },
    { "type": "header", "content": "Success" },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "Your withdrawal has been received." },
    {
      "type": "textarea",
      "id": "success_text",
      "label": "Success text",
      "default": "We have received your withdrawal and will confirm it by email shortly. No further steps are required."
    },
    { "type": "header", "content": "Confirmation email (Klaviyo)" },
    {
      "type": "text",
      "id": "klaviyo_public_key",
      "label": "Klaviyo public site key",
      "default": "W24JTE",
      "info": "Public (site) key. Powers the automatic confirmation email via the 'Withdrawal Requested' flow."
    },
    { "type": "text", "id": "klaviyo_metric_name", "label": "Klaviyo metric name", "default": "Withdrawal Requested" }
  ],
  "presets": [{ "name": "Withdrawal Form (EU)" }]
}
{% endschema %}
